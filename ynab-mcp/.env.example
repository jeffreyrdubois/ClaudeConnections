# Required: Your YNAB Personal Access Token
# Generate one at: https://app.ynab.com/settings/developer
YNAB_API_TOKEN=your_ynab_personal_access_token_here

# Optional: Your YNAB Budget ID
# Found in the URL when viewing your budget:
#   https://app.ynab.com/budgets/YOUR-BUDGET-ID/budget
# Leave as "last-used" to auto-select your most recent budget.
YNAB_BUDGET_ID=last-used

# ── MCP Auth ──────────────────────────────────────────────────────────────────
# Recommended: a secret token to protect your MCP endpoint.
# Set any long random string (e.g. output of: openssl rand -hex 32)
# Use this same value when configuring the remote MCP server in Claude.ai
OAUTH_CLIENT_ID=ynab-mcp
OAUTH_CLIENT_SECRET=

# Optional: Port the server listens on (default: 3000)
PORT=3000

# Cloudflare Tunnel is managed by the shared cloudflared container.
# See cloudflared/.env.example in this repo.
