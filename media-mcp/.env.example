# ── Sonarr ────────────────────────────────────────────────────────────────────
# Your Sonarr instance URL (e.g. http://192.168.1.100:8989)
SONARR_URL=http://your-sonarr-host:8989
# Sonarr API key — found in Sonarr → Settings → General → API Key
SONARR_API_KEY=

# ── Radarr ────────────────────────────────────────────────────────────────────
# Your Radarr instance URL (e.g. http://192.168.1.100:7878)
RADARR_URL=http://your-radarr-host:7878
# Radarr API key — found in Radarr → Settings → General → API Key
RADARR_API_KEY=

# ── Tautulli ──────────────────────────────────────────────────────────────────
# Your Tautulli instance URL (e.g. http://192.168.1.100:8181)
TAUTULLI_URL=http://your-tautulli-host:8181
# Tautulli API key — found in Tautulli → Settings → Web Interface → API Key
TAUTULLI_API_KEY=

# ── Overseerr ─────────────────────────────────────────────────────────────────
# Your Overseerr instance URL (e.g. http://192.168.1.100:5055)
OVERSEERR_URL=http://your-overseerr-host:5055
# Overseerr API key — found in Overseerr → Settings → General → API Key
OVERSEERR_API_KEY=

# ── MCP Auth ──────────────────────────────────────────────────────────────────
# Recommended: a secret token to protect your MCP endpoint.
# Set any long random string (e.g. output of: openssl rand -hex 32)
# Use this same value when configuring the remote MCP server in Claude.ai
OAUTH_CLIENT_ID=media-mcp
OAUTH_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the MCP server listens on (default: 3000)
PORT=3000

# Cloudflare Tunnel is managed by the shared cloudflared container.
# See cloudflared/.env.example in this repo.
