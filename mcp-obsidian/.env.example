# ── Vault ─────────────────────────────────────────────────────────────────────
# Path INSIDE the container to your markdown vault. This is the same folder
# SilverBullet mounts as its /space, so notes are shared between the editor,
# the read-only view, and this MCP server. Leave as /vault for the compose stack.
VAULT_DIR=/vault

# Comma-separated list of file extensions the MCP server is allowed to
# create/edit/delete. Reading is allowed for any file in the vault. Defaults to
# markdown + plain text + canvas.
NOTE_EXTENSIONS=.md,.markdown,.txt,.canvas

# ── MCP Auth ──────────────────────────────────────────────────────────────────
# OAuth client id used when configuring Claude.ai remote MCP. Any value is fine.
OAUTH_CLIENT_ID=mcp-obsidian

# Secret bearer token that protects the MCP endpoint. Generate one with:
#   openssl rand -hex 32
# Use this same value when adding the remote MCP server in Claude.ai.
# Leave blank to disable app-level auth (NOT recommended if exposed publicly —
# rely on Cloudflare Access Service Auth instead, see obsidian-garden/README.md).
OAUTH_CLIENT_SECRET=

# Port the server listens on (default: 3004).
PORT=3004
