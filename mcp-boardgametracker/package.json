{
  "name": "mcp-boardgametracker",
  "version": "1.0.0",
  "description": "Board game tracker web UI for tracking matches, results, and analytics",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build:client && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "import": "tsx scripts/import-excel.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
