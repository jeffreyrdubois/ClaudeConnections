# ══════════════════════════════════════════════════════════════════════════════
# obsidian-garden environment
# Copy this file to ".env" and fill in the values, then: docker compose up -d
# ══════════════════════════════════════════════════════════════════════════════

# ── SilverBullet (editable wiki on port 4000) ─────────────────────────────────
# Built-in login as username:password. This is a second layer behind Cloudflare.
SB_USER=admin:change-me-to-a-strong-password

# Friendly name shown in the app / browser tab.
SB_NAME=My Garden

# ── Public read-only garden (port 4001, only with --profile public) ───────────
SB_RO_USER=viewer:change-me-too

# ── File ownership ────────────────────────────────────────────────────────────
# UID/GID that should own the notes. On Unraid the default is 99:100 (nobody:users).
# SilverBullet AND the MCP server both run as this id so they can edit each
# other's files. Make sure ./space and ./mcp-config are owned by this uid:gid:
#   chown -R 99:100 ./space ./mcp-config
PUID=99
PGID=100

# ── MCP server (port 3004) ────────────────────────────────────────────────────
# OAuth client id used when adding the remote MCP server in Claude. Any value.
OAUTH_CLIENT_ID=mcp-obsidian

# Secret bearer token protecting the MCP endpoint (app-level auth, in addition to
# Cloudflare Access). Generate one with:  openssl rand -hex 32
OAUTH_CLIENT_SECRET=

# Extensions the MCP server may create/edit/delete (reading is always allowed).
NOTE_EXTENSIONS=.md,.markdown,.txt,.canvas

# ── Cloudflare Tunnel (optional, only with --profile tunnel) ──────────────────
# Token from the Cloudflare Zero Trust dashboard (Networks → Tunnels → your tunnel).
TUNNEL_TOKEN=
