# ── Journiv ───────────────────────────────────────────────────────────────────
# Internal Docker-network URL for Journiv's API. This is the INTERNAL hostname,
# not the public one behind Cloudflare Access. On the same Docker network the
# hostname is usually the service name from Journiv's compose file.
JOURNIV_URL=http://journiv:8000

# The Journiv account that OWNS your journals — i.e. your own login. Journiv is
# single-user (journals/entries/tags are scoped to one account, no sharing, no
# app tokens), so a separate "MCP-only" account would only see its own empty data
# and never find your journals. Privacy is enforced by the ai-tag allowlist below,
# not by the account: the tools only ever return ai-tagged entries even though the
# login can read everything.
JOURNIV_MCP_USER=you@example.com
JOURNIV_MCP_PASS=

# The allowlist tag. Only entries carrying this tag are visible to Claude, and
# every entry the MCP creates gets it automatically. Change only if you want a
# different opt-in tag. Compared case-insensitively.
JOURNIV_REQUIRED_TAG=ai

# Optional: pin new entries to a specific journal. Journiv requires a journal_id
# on every new entry and has no "default journal", so if this is blank the server
# auto-resolves your first journal on the first write and reuses it. Set this only
# if you keep multiple journals and want AI-authored entries in a particular one.
# Find the id in the Journiv URL when viewing a journal, or via GET /api/v1/journals/.
JOURNIV_JOURNAL_ID=

# Optional Host header override. Journiv (Starlette TrustedHostMiddleware) only
# accepts requests whose Host matches its configured public hostname (DOMAIN_NAME),
# so reaching it by internal IP returns "Invalid host header". If JOURNIV_URL uses
# an IP/hostname Journiv doesn't trust, set this to Journiv's PUBLIC hostname
# (no scheme, no port, no path) — the MCP then connects to JOURNIV_URL's address
# but presents this Host so Journiv accepts it. No Journiv config change needed.
# Leave blank if JOURNIV_URL's own host is already trusted (e.g. same Docker network).
JOURNIV_HOST_HEADER=

# ── MCP Auth ──────────────────────────────────────────────────────────────────
# A secret token protecting the MCP endpoint. Set any long random string
# (e.g. output of: openssl rand -hex 32) and use the same value when
# registering the remote MCP connector in Claude. The MCP hostname has no
# Cloudflare Access policy, so THIS is the boundary — do not leave it blank
# when the endpoint is internet-reachable.
OAUTH_CLIENT_ID=mcp-journiv
OAUTH_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the MCP server listens on inside the container (default: 3000).
PORT=3000

# Cloudflare Tunnel is managed by the shared cloudflared container.
# Add a route: journalmcp.<your-domain> -> http://mcp-journiv:3000
# See cloudflared/.env.example in this repo.
