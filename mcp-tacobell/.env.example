# ── Taco Bell Account ─────────────────────────────────────────────────────────
# Your tacobell.com account credentials
TB_EMAIL=your@email.com
TB_PASSWORD=yourpassword

# ── Default Location ──────────────────────────────────────────────────────────
# Optional: pre-set your local store ID so you don't have to find it every time.
# Use the tacobell_find_stores tool to discover your store ID, then paste it here.
TB_DEFAULT_STORE_ID=

# ── MCP Auth ──────────────────────────────────────────────────────────────────
# A secret token to protect your MCP endpoint.
# Set any long random string (e.g. output of: openssl rand -hex 32)
# Use this same value when configuring the remote MCP server in Claude.ai
OAUTH_CLIENT_ID=mcp-tacobell
OAUTH_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the MCP server listens on (default: 3000)
PORT=3000
