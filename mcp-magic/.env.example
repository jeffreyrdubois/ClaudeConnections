# ── OAuth (optional — enables Bearer token auth on the MCP endpoint) ──────────
# If not set, the MCP endpoint is open (fine for local / trusted network use)
OAUTH_CLIENT_ID=mcp-magic
OAUTH_CLIENT_SECRET=your-secret-here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Data directory (SQLite database location) ─────────────────────────────────
# In Docker, this is overridden to /data (mounted volume)
DATA_DIR=./data
